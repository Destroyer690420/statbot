generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskType {
  POST
  COMMENT
}

enum TaskStatus {
  ACCEPTED
  PENDING
  REMINDER_20_SENT
  INSIGHT_20_RECEIVED
  REMINDER_70_SENT
  INSIGHT_70_RECEIVED
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum ReminderType {
  POST_20H
  POST_70H
  COMMENT_20H
}

enum AuditAction {
  TASK_CREATED
  TASK_DELETED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_CANCELLED
  TASK_ARCHIVED
  REMINDER_SENT
  REMINDER_COMPLETED
  REMINDER_RETRY
  REMINDER_RESCHEDULED
  INSIGHT_RECEIVED
  ADMIN_ALERT
  COMMAND_USED
  PAYOUT_BATCH_CREATED
  PAYOUT_ITEM_CREATED
  REFERRAL_ADDED
  REFERRAL_REMOVED
  COMMISSION_PAID
  COMMISSION_BATCH_CREATED
  TASK_ASSIGNED
  URL_SUBMITTED
  TASK_REVIEWED
  TASK_ACCEPTED
  ASSIGNMENT_RETRIED
  OUTREACH_MESSAGE_SENT
  AUTOMATION_CYCLE_STARTED
  AUTOMATION_CONTACT_SENT
  AUTOMATION_CONTACT_CONFIRMED
  AUTOMATION_TASK_ACCEPTED
  AUTOMATION_TASK_FAILED
  AUTOMATION_BLOCKED
  AUTOMATION_SESSION_UPDATED
  AUTOMATION_STOPPED
}

enum ReferralStatus {
  pending
  qualified
  active_per_task
  closed
}

enum InviterType {
  normal
  special
}

enum CommissionKind {
  one_time
  per_task
  per_task_indirect
}

model Task {
  id               String   @id
  redditUrl        String?
  type             TaskType
  status           TaskStatus
  guildId          String
  channelId        String
  channelName      String?
  assignedUserId   String
  assignedUserName String?
  createdById      String
  notes            String?
  cancelledReason  String?

  // GoPartTime → Discord delivery fields
  source           String?
  externalTaskId   String?
  sourceUrl        String?
  subreddit        String?
  subredditUrl     String?
  flair            String?
  title            String?
  postLink         String?
  commentLink      String?
  contentHtml      String?
  formattedContent String?
  payment          String?
  deadline         String?
  taskImages       Json?
  deliveryMessages Json?
  assignmentStatus String?
  assignmentError  String?
  submittedRedditUrl String?
  submittedAt      DateTime?
  submittedBy      String?
  reviewedAt       DateTime?
  reviewedBy       String?

  createdAt        DateTime
  updatedAt        DateTime

  reminders        Reminder[]
  auditLogs        AuditLog[]
  payoutItems      PayoutItem[]
  commissionItems  CommissionItem[]

  @@index([status])
  @@index([status, guildId])
  @@index([channelId])
  @@index([assignedUserId])
  @@index([redditUrl, guildId])
  @@index([channelName, status])
  @@index([assignedUserId, status])
  @@index([createdAt])
  @@unique([source, externalTaskId])
}

model Reminder {
  id                 String       @id
  taskId             String
  type               ReminderType
  dueAt              DateTime
  sent               Boolean      @default(false)
  completed          Boolean      @default(false)
  sentAt             DateTime?
  completedAt        DateTime?
  retryCount         Int          @default(0)
  jobId              String?
  reminderMessageId  String?
  insightImageUrl    String?
  insightImageName   String?
  insightUploadedAt  DateTime?

  task               Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([sent, completed])
  @@index([reminderMessageId])
}

model AuditLog {
  id        String       @id
  action    AuditAction
  taskId    String?
  userId    String?
  details   String?
  createdAt DateTime

  task      Task?        @relation(fields: [taskId], references: [id])

  @@index([taskId, createdAt])
  @@index([createdAt])
}

model PayoutBatch {
  id            String       @id
  batchNumber   Int
  weekStart     DateTime
  weekEnd       DateTime
  totalWorkers  Int
  totalTasks    Int
  totalPosts    Int
  totalComments Int
  totalAmount   Float
  paidAt        DateTime?
  createdBy     String
  createdAt     DateTime

  items         PayoutItem[]

  @@index([batchNumber])
  @@index([weekStart, weekEnd])
  @@index([weekEnd])
}

model PayoutItem {
  id          String    @id
  batchId     String
  taskId      String
  workerId    String
  taskType    TaskType
  amount      Float
  completedAt DateTime
  createdAt   DateTime

  batch       PayoutBatch @relation(fields: [batchId], references: [id])
  task        Task        @relation(fields: [taskId], references: [id])

  @@index([batchId])
  @@index([taskId])
}

model Referral {
  id                       String          @id
  inviterId                String
  inviterName              String
  inviteeId                String
  inviteeName              String
  inviterType              InviterType
  status                   ReferralStatus
  oneTimeCommissionPaid    Boolean         @default(false)
  oneTimeCommissionPaidAt  DateTime?
  perTaskCommissionActive  Boolean         @default(false)
  ticketId                 String?
  indirectSpecialInviterId String?
  createdAt                DateTime
  updatedAt                DateTime

  commissionItems          CommissionItem[]

  @@index([inviterId])
  @@index([inviteeId, inviterId])
  @@index([createdAt])
  @@index([indirectSpecialInviterId])
}

model CommissionBatch {
  id            String          @id
  batchNumber   Int
  weekStart     DateTime
  weekEnd       DateTime
  totalInviters Int
  totalAmount   Float
  paidAt        DateTime?
  createdAt     DateTime

  items         CommissionItem[]

  @@index([batchNumber])
}

model CommissionItem {
  id               String        @id
  batchId          String
  referralId       String
  inviterId        String
  invitedWorkerId  String
  sourceTaskId     String?
  commissionKind   CommissionKind
  amount           Float
  createdAt        DateTime

  batch            CommissionBatch @relation(fields: [batchId], references: [id])
  referral         Referral        @relation(fields: [referralId], references: [id])
  task             Task?            @relation(fields: [sourceTaskId], references: [id])

  @@index([batchId])
  @@index([referralId, inviterId, commissionKind])
  @@index([inviterId, sourceTaskId, commissionKind])
}

model PayoutSettings {
  id          String   @id @default("payout-rates")
  commentRate Float
  postRate    Float
  updatedAt   DateTime
  updatedBy   String
}

model CommissionRates {
  id                        String   @id @default("commission-rates")
  normalInviteBonus         Float
  normalInviteTaskThreshold Int
  specialInviteBonus        Float
  specialInviteTaskThreshold Int
  specialPerComment         Float
  specialPerPost            Float
  updatedAt                 DateTime
  updatedBy                 String
}

model TicketOutreach {
  id            String    @id @default(cuid())
  channelId     String    @unique
  selected      Boolean   @default(false)
  messageSentAt DateTime?
  availableAt   DateTime?
  updatedAt     DateTime  @updatedAt
}

model OutreachSettings {
  id        String   @id @default("outreach-message")
  message   String
  updatedAt DateTime
  updatedBy String
}

model OutreachBlast {
  id          String   @id @default(cuid())
  slotsTotal  Int
  slotsFilled Int      @default(0)
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  createdBy   String?

  messages OutreachBlastMessage[]
  replies  OutreachReply[]

  @@index([status, createdAt])
}

model OutreachBlastMessage {
  id        String   @id @default(cuid())
  blastId   String
  channelId String
  messageId String
  createdAt DateTime @default(now())

  blast OutreachBlast @relation(fields: [blastId], references: [id], onDelete: Cascade)

  @@unique([blastId, channelId])
  @@index([blastId])
}

model OutreachReply {
  id        String   @id @default(cuid())
  blastId   String
  channelId String
  workerId  String
  repliedAt DateTime @default(now())

  blast OutreachBlast @relation(fields: [blastId], references: [id], onDelete: Cascade)

  @@unique([blastId, channelId])
  @@index([blastId])
}

model TicketOnboarding {
  channelId     String    @id
  welcomeSentAt DateTime?
  guideSentAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model BlockedSubreddit {
  subreddit String   @id
  reason    String?
  createdAt DateTime @default(now())
  createdBy String
}

model AutomationSettings {
  id          String   @id @default("automation")
  enabled     Boolean  @default(false)
  dryRun      Boolean  @default(true)
  pollEnabled Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedBy   String
}

model GoPartTimeSession {
  id            String   @id @default("default")
  sessionCipher String?
  csrfCipher    String?
  callbackUrl   String?
  nextAction    String?
  userAgent     String?
  updatedAt     DateTime @updatedAt
  updatedBy     String
}

model AutomationCycle {
  id               String    @id
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  status           String    @default("RUNNING")
  tasksDetected    Int       @default(0)
  eligiblePosts    Int       @default(0)
  blocked          Int       @default(0)
  duplicates       Int       @default(0)
  commentsSkipped  Int       @default(0)
  workersContacted Int       @default(0)
  workersConfirmed Int       @default(0)
  postsAccepted    Int       @default(0)
  failures         Int       @default(0)
  dryRun           Boolean   @default(true)

  @@index([startedAt])
  @@index([status])
}

model AutomationContact {
  id          String    @id @default(cuid())
  cycleId     String
  channelId   String
  workerId    String?
  status      String    @default("CONTACTED")
  sentAt      DateTime  @default(now())
  expiresAt   DateTime
  respondedAt DateTime?
  messageId   String?

  @@index([cycleId])
  @@index([channelId, status])
}

model AutomationTaskLog {
  id            String   @id @default(cuid())
  cycleId       String
  externalTaskId String
  taskType      String
  subreddit     String?
  status        String
  workerId      String?
  failureReason String?
  createdAt     DateTime @default(now())

  @@index([cycleId])
  @@index([externalTaskId])
}

model AutomationSighting {
  id             String   @id @default(cuid())
  externalTaskId String   @unique
  taskType       String
  subreddit      String?
  title          String?
  status         String   @default("NEW")
  companionId    String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())

  @@index([status, lastSeenAt])
}

model AutomationClaim {
  id             String    @id @default(cuid())
  cycleId        String
  externalTaskId String
  channelId      String
  workerId       String?
  status         String    @default("PENDING")
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  respondedAt    DateTime?
  failureReason  String?

  @@index([status, expiresAt])
  @@index([externalTaskId])
}

model CompanionStatus {
  id         String   @id @default("companion")
  lastSeenAt DateTime @default(now())
  version    String?
  updatedAt  DateTime @updatedAt
}

model AutomationBurst {
  id          String   @id @default(cuid())
  blastId     String   @unique
  cycleId     String
  taskIds     String[]
  taskDetails String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}
model InviteDetection {
  id              String    @id
  inviterId       String?
  inviterName     String?
  inviteeId       String
  inviteeName     String?
  inviteCode      String?
  ticketChannelId String?
  ticketName      String?
  status          String    @default("pending")
  createdAt       DateTime
  updatedAt       DateTime

  @@index([inviteeId])
  @@index([status])
  @@index([createdAt])
}
